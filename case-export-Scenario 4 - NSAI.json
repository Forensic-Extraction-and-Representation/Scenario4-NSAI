        }, {
            "Name": "All Inferrred",
            "Description": "Retrieves all entities that are either a subject or object of an inferred knowledge predicate.",
            "QueryText": "PREFIX autopsy: \u003Chttps://purl.org/ontology/autopsy/\u003E\nPREFIX fik: \u003Chttp://inferred-knowledge.fear.graph/\u003E\n\nCONSTRUCT {\n?relatedSubject ?predicate ?object\n}\nWHERE {\n  {\n    SELECT DISTINCT ?relatedSubject\n    WHERE {\n      ?relatedSubject ?p ?o .\n      FILTER(STRSTARTS(STR(?p), \u0022http://inferred-knowledge.fear.graph/\u0022))\n    }\n  }\n\n  {\n    ?relatedSubject ?predicate ?object .\n  }\n}"
